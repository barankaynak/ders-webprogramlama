@*
    HAFTA 7 — sepet (Hafta 7 ders notu bölüm 3).
    Liste session'dan geliyor: controller NesneOku ile okuyup modele verdi.
*@
@model List<SepetSatiri>

<h1>Sepet</h1>

@if (TempData["Mesaj"] != null)
{
    <div class="ipucu"><strong>✓ @TempData["Mesaj"]</strong></div>
}

<p class="ipucu">
    Bu liste <strong>sunucuda</strong>, session'da duruyor. Tarayıcıda yalnızca
    <code>.AspNetCore.Session</code> cookie'si var; içinde kitap adı ya da fiyat yok.
    F12 → <em>Application</em> → <em>Cookies</em> ile bakın.
    Uygulamayı yeniden başlatın: sepet boşalır, çünkü veri sunucunun belleğindeydi.
</p>

@if (Model.Count == 0)
{
    <p class="bos">Sepet boş. Bir <a asp-controller="Kitap" asp-action="Index">kitabın</a> sayfasından ekleyin.</p>
}
else
{
    <table class="table ms-tablo">
        <thead><tr><th>Kitap</th><th>Fiyat</th><th>Adet</th><th>Tutar</th><th></th></tr></thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td><a asp-controller="Kitap" asp-action="Detay" asp-route-id="@s.KitapId">@s.Baslik</a></td>
                    <td>@s.Fiyat.ToString("N2") TL</td>
                    <td>@s.Adet</td>
                    <td>@((s.Fiyat * s.Adet).ToString("N2")) TL</td>
                    <td>
                        <form asp-action="Cikar" asp-route-id="@s.KitapId" method="post">
                            <button type="submit">Çıkar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><th colspan="3">Toplam</th><th>@Model.Sum(s => s.Fiyat * s.Adet).ToString("N2") TL</th><th></th></tr>
        </tfoot>
    </table>

    <form asp-action="Bosalt" method="post">
        <button type="submit">Sepeti boşalt</button>
    </form>
}
