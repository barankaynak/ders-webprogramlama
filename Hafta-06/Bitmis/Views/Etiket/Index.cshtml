@*
    HAFTA 5 — asp-for ne üretiyor? (Hafta 5 ders notu bölüm 3)

    Soldaki sütun YAZDIĞIMIZ Razor, sağdaki sütun TARAYICIYA GİDEN HTML.
    Sağ sütunu elle yazmadık: sayfadaki küçük betik her denetimin kendi
    outerHTML'ini okuyup basıyor. Yani bu tablo asla eskimez.

    Sunucunun gönderdiği baytların birebir hâli için Ctrl+U.
*@
@model KampusKitap.ViewModels.EtiketVM
@{
    // List<int> özelliğe bağlı select için: Hafta 5 ders notu bölüm 3.4
    var kategoriler = new SelectList(KampusKitap.Data.KitapDeposu.Kategoriler, "Key", "Value");

    // <optgroup> üretmek için her seçeneğe bir grup verilir
    var lisans = new SelectListGroup { Name = "Lisans" };
    var yuksek = new SelectListGroup { Name = "Yüksek lisans" };
    var dersler = new List<SelectListItem>
    {
        new() { Value = "1", Text = "Web Programlama",      Group = lisans },
        new() { Value = "2", Text = "Veri Yapıları",        Group = lisans },
        new() { Value = "3", Text = "İleri Web Mimarileri", Group = yuksek }
    };
}

<h1><code>asp-for</code> ne üretiyor?</h1>

<p class="ipucu">
