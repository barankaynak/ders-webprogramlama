@model List<Kitap>

<h1>@ViewData["KategoriAdi"]</h1>

@if (Model.Count == 0)
{
    <p class="bos">Bu kategoride listelenecek kitap yok. (Başlangıç projesindeyseniz: TODO 9.9)</p>
}
else
{
    <p>@Model.Count kitap:</p>
    <div class="kart-liste">
        @foreach (var k in Model)
        {
            <partial name="_KitapKart" model="k" />
        }
    </div>
}

<p class="ipucu">
    Bu view <code>Views/Kategori/Detay.cshtml</code> yolunda bulundu.
    Dosyayı silip sayfayı yenilerseniz, çatı aradığı iki yolu listeleyen
    bir hata verir (Hafta 3 ders notu bölüm 2.5 · 🐛 Hata Köşesi).
</p>
<p><a asp-controller="Kategori" asp-action="Index">← Kategoriler</a></p>
